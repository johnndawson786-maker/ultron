# Optional. Copy to .env to override. No API key required — runs locally.

# Local server (Ollama default). LM Studio: http://127.0.0.1:1234/v1
# CYBER_BASE_URL=http://127.0.0.1:11434/v1

# Model to drill. Stronger models pass more of the bank:
#   llama3.1, qwen2.5, qwen2.5:14b, mistral-nemo ...
# CYBER_MODEL=llama3.1

# CYBER_TEMPERATURE=0.2          # low = precise/deterministic

# --- training-loop knobs ---
# CYBER_PASS_THRESHOLD=0.6       # rubric coverage needed to pass one question
# CYBER_MAX_ROUNDS=3             # retries per question (with study notes fed back)
# CYBER_READINESS=0.8            # fraction of questions to pass to be "ready"

# Only if you front the local server with an authenticating proxy:
# CYBER_API_KEY=

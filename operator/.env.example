# Copy to .env to override. Defaults = local Ollama, no API key, safest autonomy.

# --- brain (pluggable) ---
# Local Ollama (default):
# OPERATOR_BASE_URL=http://127.0.0.1:11434/v1
# OPERATOR_MODEL=llama3.1
#
# Or any OpenAI-compatible API (stronger reasoning, costs money):
# OPERATOR_BASE_URL=https://api.openai.com/v1
# OPERATOR_MODEL=gpt-4o-mini
# OPERATOR_API_KEY=sk-...

# OPERATOR_TEMPERATURE=0.3

# --- agent loop ---
# OPERATOR_MAX_STEPS=20
# OPERATOR_BUDGET_SECONDS=900

# --- autonomy / safety ---
# auto (default; acts without asking, everything logged to `operator log`)
# approval (asks before each command) | semi (asks before changes only)
# OPERATOR_AUTONOMY=auto
#
# Active security testing is ENABLED by default, but active scans only ever run
# against hosts you add with `operator scope add <host>` (authorized targets
# only). Set to false for mentor + passive-OSINT only.
# OPERATOR_ALLOW_ACTIVE_TESTING=true

# Where knowledge/memory/scope live:
# OPERATOR_DATA_DIR=~/.operator

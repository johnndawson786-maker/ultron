# Copy to .env to override. Defaults = local Ollama, no API key, safest autonomy.

# --- brain (pluggable) ---
# Local Ollama (default):
# OPERATOR_BASE_URL=http://127.0.0.1:11434/v1
# OPERATOR_MODEL=llama3.1
#
# Or any OpenAI-compatible API (stronger reasoning, costs money):
# OPERATOR_BASE_URL=https://api.openai.com/v1
# OPERATOR_MODEL=gpt-4o-mini
# OPERATOR_API_KEY=sk-...

# OPERATOR_TEMPERATURE=0.3

# --- agent loop ---
# OPERATOR_MAX_STEPS=20
# OPERATOR_BUDGET_SECONDS=900

# --- autonomy / safety ---
# approval (default, safest) | semi | auto
# OPERATOR_AUTONOMY=approval
#
# Active security testing is OFF by default. Turn on ONLY for targets you are
# authorized to test, and still add each host with `operator scope add <host>`.
# OPERATOR_ALLOW_ACTIVE_TESTING=false

# Where knowledge/memory/scope live:
# OPERATOR_DATA_DIR=~/.operator

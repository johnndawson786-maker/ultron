# Copy to .env and fill in, or export these in your shell.
# Required (unless you use `ant auth login`):
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional overrides (defaults shown):
# FABLE5_MODEL=claude-fable-5
# FABLE5_MAX_TOKENS=16000
# FABLE5_EFFORT=high                 # low | medium | high | xhigh | max
# FABLE5_USE_FALLBACK=true           # server-side refusal fallback
# FABLE5_FALLBACK_MODEL=claude-opus-4-8
# FABLE5_SHOW_THINKING=false         # stream a summary of the model's reasoning
# FABLE5_SYSTEM_PROMPT=You are Fable, a sharp, friendly assistant.

# Optional. Copy to .env to override defaults. No API key is required.

# Where your local server listens (Ollama default shown).
# LM Studio:   http://127.0.0.1:1234/v1
# llama.cpp:   http://127.0.0.1:8080/v1
# LOCAL_BASE_URL=http://127.0.0.1:11434/v1

# Which local model to use (must be pulled/loaded in your server).
# LOCAL_MODEL=llama3.2

# LOCAL_TEMPERATURE=0.7
# LOCAL_MAX_TOKENS=0            # 0 = let the server decide
# LOCAL_SYSTEM_PROMPT=You are a helpful assistant running locally.
# LOCAL_TIMEOUT=300

# Only needed if you put an authenticating proxy in front of your local server.
# LOCAL_API_KEY=
